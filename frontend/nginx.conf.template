# Rate limiting zones per client IP address
limit_req_zone $binary_remote_addr zone=general_limit:10m rate=${NGINX_GENERAL_RATE_LIMIT};
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=${NGINX_AUTH_RATE_LIMIT};
limit_req_status 429;

server {
    listen 8080;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Strict rate limit for authentication endpoints
    location /api/auth/ {
        limit_req zone=auth_limit burst=${NGINX_AUTH_BURST} nodelay;

        proxy_pass ${NGINX_BACKEND_URL};
        proxy_ssl_server_name on;
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # General rate limit for all API endpoints
    location /api/ {
        limit_req zone=general_limit burst=${NGINX_GENERAL_BURST} nodelay;

        proxy_pass ${NGINX_BACKEND_URL};
        proxy_ssl_server_name on;
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}