{
  "ConnectionStrings": {
    "AzureStorage": "UseDevelopmentStorage=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "DefaultPermitLimit": 100,
    "DefaultWindowSeconds": 60,
    "AuthPermitLimit": 15,
    "AuthWindowSeconds": 60,
    "AiPermitLimit": 20,
    "AiWindowSeconds": 60,
    "QueueLimit": 0
  }
}
