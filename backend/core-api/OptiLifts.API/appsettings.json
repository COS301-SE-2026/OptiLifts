{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Enabled": true,
    "DefaultPermitLimit": 200,
    "DefaultWindowSeconds": 60,
    "AuthPermitLimit": 30,
    "AuthWindowSeconds": 60,
    "AiPermitLimit": 40,
    "AiWindowSeconds": 60,
    "CalendarPermitLimit": 600,
    "CalendarWindowSeconds": 60,
    "SchedulePermitLimit": 600,
    "ScheduleWindowSeconds": 60,
    "QueueLimit": 0
  }
}